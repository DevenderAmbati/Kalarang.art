rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      allow read: if true; // Anyone can read user profiles
      allow write: if request.auth != null && request.auth.uid == userId; // Only owner can update

      // Shortlisted commissions (artist bookmark) — allows reading commission doc after it leaves "open"
      match /commissionShortlists/{commissionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Artworks collection
    match /artworks/{artworkId} {
      allow read: if true; // Anyone can read artworks
      allow create: if request.auth != null && request.resource.data.artistId == request.auth.uid; // Only authenticated users can create their own artworks
      allow update: if request.auth != null && (
        resource.data.artistId == request.auth.uid || // Owner can update all fields
        // Engagement counters can be updated by authenticated users
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'favorites', 'reachOutClicks', 'likes', 'comments'])) ||
        // Any authenticated user can mark artwork as sold (triggered by Buy Now / offer acceptance)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold', 'updatedAt']) && request.resource.data.sold == true)
      );
      allow delete: if request.auth != null && resource.data.artistId == request.auth.uid; // Only owner can delete
    }
    
    // Likes collection
    match /likes/{likeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Favorites collection
    match /favorites/{favoriteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Follows collection
    match /follows/{followId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Comments on artworks (optional parentCommentId for artist replies)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['artworkId', 'userId', 'userName', 'text', 'createdAt'])
        && (
          !request.resource.data.keys().hasAny(['parentCommentId'])
          || (
            request.resource.data.parentCommentId is string
            && request.resource.data.parentCommentId.size() > 0
            && get(/databases/$(database)/documents/artworks/$(request.resource.data.artworkId)).data.artistId == request.auth.uid
          )
        );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
    
    // Stories collection
    match /stories/{storyId} {
      allow read: if true; // Anyone can read stories
      allow create: if request.auth != null && request.resource.data.artistId == request.auth.uid; // Only authenticated users can create their own stories
      allow delete: if request.auth != null && resource.data.artistId == request.auth.uid; // Only owner can delete
    }

    // Commissions collection
    match /commissions/{commissionId} {
      allow create: if request.auth != null
                    && request.resource.data.buyerId == request.auth.uid;
      // Open listings (anyone). Non-open: any signed-in user can read (browse / fallback when callable fails).
      allow read: if resource.data.status == "open"
                  || request.auth != null;
      allow update: if request.auth != null && (
                      resource.data.buyerId == request.auth.uid
                      || (
                        resource.data.hiredArtistId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readyToShipImageUrl', 'updatedAt', 'status', 'trackingId'])
                      )
                    );
      allow delete: if request.auth != null
                    && resource.data.buyerId == request.auth.uid;

      // One doc per artist who applied — lets applicants read the parent commission after it leaves "open"
      match /applications/{artistId} {
        allow read: if request.auth != null
                    && (
                      request.auth.uid == artistId
                      || request.auth.uid == get(/databases/$(database)/documents/commissions/$(commissionId)).data.buyerId
                    );
        allow create: if request.auth != null
                      && request.auth.uid == artistId
                      && request.resource.data.artistId == artistId
                      && get(/databases/$(database)/documents/commissions/$(commissionId)).data.status == "open";
        // Idempotent apply / merge: updates are same artist only (merge:true after doc exists would otherwise fail).
        allow update: if request.auth != null
                      && request.auth.uid == artistId
                      && resource.data.artistId == artistId
                      && request.resource.data.artistId == artistId;
        allow delete: if false;
      }
    }
    
    // Story Views collection
    match /storyViews/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId; // Users can only read their own views
      allow write: if request.auth != null && request.auth.uid == userId; // Users can only write their own views
    }

    // Post Views collection (seen tracking)
    // Document ID convention: {userId}__{postId} to keep userId+postId unique.
    match /post_views/{viewId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create, update: if request.auth != null
                            && request.resource.data.userId == request.auth.uid
                            && request.resource.data.postId is string;
      allow delete: if false;
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientId; // Users can only read their own notifications
      allow create: if request.auth != null; // Any authenticated user can create notifications
      allow update: if request.auth != null && request.auth.uid == resource.data.recipientId; // Only recipient can update (mark as read)
      allow delete: if request.auth != null && request.auth.uid == resource.data.recipientId; // Only recipient can delete
    }
    
    // Chats collection — only participants may read/write
    // For queries: request.auth.uid must be in participants array
    // For direct reads (new chats): chatId contains user's uid
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && (request.auth.uid in resource.data.participants
                      || chatId.split('_').hasAny([request.auth.uid]));
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && chatId.split('_').hasAny([request.auth.uid]);
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      // Messages subcollection — participants only, senderId must match auth
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && exists(/databases/$(database)/documents/chats/$(chatId))
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'offerStatus']));
      }
    }

    // Dedicated Commission Chats collection (separate from normal chats)
    match /commissionChats/{chatId} {
      // Allow read on missing docs so clients can getDoc before create; existing docs require participant
      allow read: if request.auth != null
                  && (
                    !exists(/databases/$(database)/documents/commissionChats/$(chatId))
                    || request.auth.uid in resource.data.participants
                  );
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/commissionChats/$(chatId)).data.participants;
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && exists(/databases/$(database)/documents/commissionChats/$(chatId))
                      && request.auth.uid in get(/databases/$(database)/documents/commissionChats/$(chatId)).data.participants;
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/commissionChats/$(chatId)).data.participants
                      && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']));
      }
    }

    // FCM push notification tokens — users can manage their own device tokens
    // Document ID format: {userId}_{deviceId}
    match /userTokens/{tokenId} {
      allow read: if request.auth != null && tokenId.split('_')[0] == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && tokenId.split('_')[0] == request.auth.uid;
    }

    // Commission reviews — one per commission, written by buyer, replied by artist
    match /reviews/{reviewId} {
      allow read: if true; // Reviews are public — visible on artist portfolios
      allow create: if request.auth != null
                    && request.resource.data.buyerId == request.auth.uid;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.artistId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['artistReply', 'artistReplyAt']);
      allow delete: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
