# Firebase Cloud Functions Environment Variables
# Copy this file to .env and fill in your actual values

# Gmail address for sending support emails
GMAIL_EMAIL=kalarang.team@gmail.com

# Gmail App Password (16-character password from Google)
# Generate at: https://myaccount.google.com/apppasswords
# NEVER commit the actual .env file with real credentials
GMAIL_APP_PASSWORD=your-16-char-app-password-here

# AI Art Advisor — Gemini (artwork embeddings only; powers Pinecone search)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# AI Art Advisor — OpenAI (chat consultant; gpt-5-mini)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# AI Art Advisor — Pinecone (vector search)
# Sign up at: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=kalarang-artworks
PINECONE_INDEX_HOST=https://your-index.svc.region.pinecone.io

# Additional Notes:
# - For local development, create a .env file with these variables
# - For production, use: firebase functions:secrets:set GMAIL_APP_PASSWORD
# - The .env file is gitignored for security
# - Ensure 2FA is enabled on the Gmail account before generating app password
