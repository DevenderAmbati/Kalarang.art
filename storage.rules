rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload artworks
    match /artworks/{userId}/{fileName} {
      allow read: if true; // Anyone can read artworks
      allow write: if request.auth != null && request.auth.uid == userId; // Only the owner can upload
    }
    
    // Allow authenticated users to upload user profile images (avatar and banner)
    match /users/{userId}/{fileName} {
      allow read: if true; // Anyone can read profile images
      allow write: if request.auth != null && request.auth.uid == userId; // Only the owner can upload
    }
    
    // Allow authenticated users to upload profile images (legacy path)
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chat message images — uploader-only writes; any signed-in user can read (URL is shared via Firestore to participants)
    match /chat_images/{userId}/{scope}/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Free sketch claim attachments (reference + payment proof). Public-write offer flow.
    // Reads denied — admins use Firebase console (which bypasses rules) to view.
    match /freeSketch/{requestId}/{fileName} {
      allow read: if false;
      allow write: if request.resource.size < 10 * 1024 * 1024
                && request.resource.contentType.matches('image/.*');
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
